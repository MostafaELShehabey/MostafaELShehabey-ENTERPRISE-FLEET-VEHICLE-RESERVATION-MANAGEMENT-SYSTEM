        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // FLEET-22: vehicle defaults to the reservation's vehicle; repair_cost required when REPAIRED
    if (current.vehicle.nil() && !current.reservation.nil() && !current.reservation.assigned_vehicle.nil()) {
        current.setValue('vehicle', current.reservation.assigned_vehicle.toString());
    }
    var cost = parseFloat(current.getValue('repair_cost'));
    if (current.getValue('status') == 'REPAIRED' && (isNaN(cost) || cost <= 0)) {
        gs.addErrorMessage('Repair Cost is required when the damage is REPAIRED.');
        current.setAbortAction(true);
    }
})(current, previous);]]></script>
