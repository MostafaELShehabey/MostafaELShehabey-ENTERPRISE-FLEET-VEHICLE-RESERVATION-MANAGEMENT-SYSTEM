        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // FLEET-33: assignment notification + vehicle status sync for the old and new vehicle
    var state = current.getValue('reservation_state');
    if (current.reservation_state.changes() && state == 'ASSIGNED') {
        var driver = current.getValue('assigned_driver');
        gs.eventQueue('x_1850693_enterp_0.reservation.assigned', current, current.getValue('requested_by'),
            driver && driver != current.getValue('requested_by') ? driver : '');
    }
    var vs = new FleetVehicleStatus();
    vs.sync(current.getValue('assigned_vehicle'));
    if (previous && previous.getValue('assigned_vehicle') && previous.getValue('assigned_vehicle') != current.getValue('assigned_vehicle')) {
        vs.sync(previous.getValue('assigned_vehicle'));
    }
})(current, previous);]]></script>
