        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // FLEET-34: a passing CHECK_OUT inspection starts the trip (FLEET - Validate Check-out still applies)
    var res = new GlideRecord('x_1850693_enterp_0_reservation');
    if (!res.get(current.getValue('reservation'))) {
        return;
    }
    if (['ASSIGNED', 'READY_FOR_PICKUP'].indexOf(res.getValue('reservation_state')) < 0) {
        return;
    }
    if (res.getValue('assigned_vehicle') != current.getValue('vehicle')) {
        return;
    }
    res.setValue('check_out_odometer', current.getValue('odometer_reading'));
    res.setValue('reservation_state', 'ACTIVE');
    if (res.update()) {
        gs.addInfoMessage('Reservation ' + res.getValue('number') + ' checked out - trip is ACTIVE.');
    }
})(current, previous);]]></script>
