        <name>Assign Vehicle</name>
        <onclick/>
        <order>110</order>
        <script><![CDATA[// FLEET-33: Assign Vehicle (dispatcher). The vehicle picker (Assigned Vehicle) only offers FleetAvailability results.
if (current.assigned_vehicle.nil()) {
    var free = new FleetAvailability().getAvailableVehicles(current.getValue('vehicle_category'), current.getValue('requested_depot'),
        new GlideDateTime(current.getValue('start_datetime')), new GlideDateTime(current.getValue('end_datetime')), current.getUniqueValue());
    if (free.length === 0) {
        gs.addErrorMessage('No vehicles available. Options: Change Depot, Modify Dates (return to the requester), or Add to Waitlist.');
    } else {
        gs.addInfoMessage(free.length + ' vehicle(s) available. Select one in Assigned Vehicle and click Assign Vehicle again.');
    }
} else {
    current.setValue('reservation_state', 'ASSIGNED');
    if (current.update()) {
        gs.addInfoMessage('Vehicle ' + current.assigned_vehicle.getDisplayValue() + ' assigned to ' + current.getValue('number') + '.');
    }
}
action.setRedirectURL(current);]]></script>
