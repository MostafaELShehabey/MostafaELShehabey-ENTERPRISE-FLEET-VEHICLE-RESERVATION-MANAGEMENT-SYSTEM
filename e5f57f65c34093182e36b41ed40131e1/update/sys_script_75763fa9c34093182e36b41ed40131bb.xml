        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // FLEET-14: next_oil_change_mileage = last_maintenance_odometer + pm.interval_miles
    var interval = parseInt(gs.getProperty('x_1850693_enterp_0.pm.interval_miles', '5000'), 10);
    if (isNaN(interval) || interval <= 0) {
        interval = 5000;
    }
    var lastOdo = parseInt(current.getValue('last_maintenance_odometer') || '0', 10);
    current.setValue('next_oil_change_mileage', lastOdo + interval);
})(current, previous);]]></script>
