        <script><![CDATA[// FLEET-16: daily refresh of driver license validity (is_valid = expiration_date > today)
var today = new GlideDateTime().getLocalDate().getValue();
var lic = new GlideRecord('x_1850693_enterp_0_driver_license');
lic.addQuery('is_valid', true);
lic.addQuery('expiration_date', '<=', today);
lic.query();
while (lic.next()) {
    lic.setValue('is_valid', false);
    lic.update();
}]]></script>
