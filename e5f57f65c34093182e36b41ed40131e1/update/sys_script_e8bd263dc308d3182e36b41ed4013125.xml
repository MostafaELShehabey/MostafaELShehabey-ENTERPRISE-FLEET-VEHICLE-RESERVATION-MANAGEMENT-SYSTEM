        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // FLEET-39: PM completion resets the vehicle counters (last_maintenance_odometer / date, next oil change)
    if (new FleetPreventiveMaintenance().resetCounters(current)) {
        gs.addInfoMessage('Vehicle ' + current.vehicle.getDisplayValue() + ' service counters reset (odometer ' +
            current.getValue('service_odometer') + ').');
    }
})(current, previous);
]]></script>
