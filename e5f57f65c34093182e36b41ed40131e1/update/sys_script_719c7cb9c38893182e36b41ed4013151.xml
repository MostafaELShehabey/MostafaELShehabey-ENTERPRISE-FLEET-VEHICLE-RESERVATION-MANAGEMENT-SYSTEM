        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // FLEET-31: task approval field follows the reservation approval
    var state = current.getValue('reservation_state');
    if (state == 'PENDING_APPROVAL') {
        current.setValue('approval', 'requested');
    } else if (state == 'CANCELLED' && previous && previous.getValue('reservation_state') == 'PENDING_APPROVAL') {
        current.setValue('approval', 'not requested');
    }
})(current, previous);]]></script>
