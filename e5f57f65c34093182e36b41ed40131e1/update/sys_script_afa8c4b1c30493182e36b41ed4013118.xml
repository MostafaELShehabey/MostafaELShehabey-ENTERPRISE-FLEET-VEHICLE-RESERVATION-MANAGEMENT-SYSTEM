        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // FLEET-21: copy odometer_reading to the reservation check-out / check-in odometer
    var field = current.getValue('inspection_type') == 'CHECK_OUT' ? 'check_out_odometer' : 'check_in_odometer';
    var res = new GlideRecord('x_1850693_enterp_0_reservation');
    if (res.get(current.getValue('reservation')) && res.getValue(field) != current.getValue('odometer_reading')) {
        res.setValue(field, current.getValue('odometer_reading'));
        res.update();
    }
})(current, previous);]]></script>
