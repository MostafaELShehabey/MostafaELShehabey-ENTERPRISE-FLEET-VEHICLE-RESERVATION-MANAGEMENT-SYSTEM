        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // FLEET-31: request approval on entry to PENDING_APPROVAL; cancel open approval if cancelled while pending
    var fa = new FleetApproval();
    var state = current.getValue('reservation_state');
    if (state == 'PENDING_APPROVAL') {
        fa.requestApproval(current);
    } else if (state == 'CANCELLED' && previous && previous.getValue('reservation_state') == 'PENDING_APPROVAL') {
        fa.cancelOpenApprovals(current);
    }
})(current, previous);]]></script>
