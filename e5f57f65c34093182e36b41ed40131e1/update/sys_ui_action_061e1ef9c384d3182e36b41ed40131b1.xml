        <script><![CDATA[function fleetCancelReservation() {
    // FLEET-37: asks for the reason and cancels through FleetReservationActions.cancel() (server-side rules)
    var reason = prompt('Reason for cancelling this reservation:');
    if (!reason || !reason.trim()) {
        return false;
    }
    var ga = new GlideAjax('x_1850693_enterp_0.FleetReservationAjax');
    ga.addParam('sysparm_name', 'cancelReservation');
    ga.addParam('sysparm_sys_id', g_form.getUniqueValue());
    ga.addParam('sysparm_reason', reason.trim());
    ga.getXMLAnswer(function(answer) {
        var r = JSON.parse(answer || '{}');
        if (r.ok) {
            g_form.addInfoMessage(r.message);
            setTimeout(function() { location.reload(); }, 800);
        } else {
            g_form.addErrorMessage(r.message || 'Cancellation failed.');
        }
    });
    return false;
}]]></script>
